APP_NAME=EazyPOS
# Use "production" and APP_DEBUG=false on the live server.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Use "error" in production.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eazypos
DB_USERNAME=root
DB_PASSWORD=

# A POS stays open all day: sessions last 12 hours, and "remember me" keeps
# staff signed in on their own device.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true on the live HTTPS site.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" needs no background worker (shared hosting friendly).
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Email: invitation links are shown on screen until SMTP is filled in.
# Example for cPanel / Spaceship mail:
#   MAIL_MAILER=smtp, MAIL_HOST=mail.yourdomain.com, MAIL_PORT=465,
#   MAIL_SCHEME=smtps, MAIL_USERNAME=help@yourdomain.com, MAIL_PASSWORD=...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="help@eazyposs.store"
MAIL_FROM_NAME="${APP_NAME}"

# Only for "php artisan eazypos:import-supabase --pgsql" (one-time data move).
# Supabase > Project Settings > Database > Connection string (URI).
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
